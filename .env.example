# @BotFather dan olingan token (required)
BOT_TOKEN=

# Yuklangan fayllar va sessiya fayllari saqlanadigan papkalar
DOWNLOAD_DIR=./downloads
SESSION_DIR=./sessions

# Har bir parallel torrent sessiyasi uchun libtorrent listen porti (havzasi)
BASE_PORT=6881
PORT_POOL_SIZE=500

# Global chegara emas — har bir foydalanuvchiga 1ta faol yuklash cheklovi
# koddagi has_active_job orqali ta'minlanadi. Bu qiymat shunchaki yuqori
# ushlab turiladi (amalda cheksiz).
MAX_CONCURRENT_DOWNLOADS=500

# Yuklab bo'lgach seeding qilmasdan darhol to'xtatish
STOP_AFTER_DOWNLOAD=true

# Telegramga yuborilgach fayllarni serverda saqlab qolish
KEEP_FILES_AFTER_SEND=false

# Progress xabari necha soniyada bir tahrirlanadi
PROGRESS_EDIT_INTERVAL_SECONDS=4

# --- Userbot relay (Pyrogram) — 50MB dan katta fayllarni Docker'siz yuborish uchun ---
# my.telegram.org dan olinadi (bitta marta, telefon raqamingiz bilan).
API_ID=
API_HASH=
# 'python scripts/create_userbot_session.py' shu nom bilan sessiya fayli yaratadi.
USERBOT_SESSION_NAME=telegram_bot_userbot
# 'python scripts/setup_storage_channel.py' avtomatik to'ldiradi.
STORAGE_CHAT_ID=

# Shu hajmgacha bot to'g'ridan-to'g'ri (Bot API orqali) yuboradi.
BOT_UPLOAD_LIMIT_MB=45
# Undan katta, lekin shu hajmgacha bo'lgan fayllar userbot orqali yuboriladi
# (Telegramning umumiy 2000MB chegarasidan past saqlanadi).
USERBOT_UPLOAD_LIMIT_MB=1900

# --- Local Bot API Server (ixtiyoriy muqobil, Docker talab qiladi) ---
# https://github.com/tdlib/telegram-bot-api — userbot relay o'rniga yoki u bilan
# birga ishlatilishi mumkin emas, faqat bittasi tanlanadi (userbot ustuvor).
# LOCAL_BOT_API_BASE_URL=http://localhost:8081/bot
# LOCAL_BOT_API_BASE_FILE_URL=http://localhost:8081/file/bot

# Yuqoridagi limitlardan qat'iy nazar, bitta fayl uchun oxirgi chegara (MB) —
# undan katta fayllar avtomatik qismlarga bo'linadi (Telegramning shaxsiy
# hard-limiti ~2000MB, hech qanday usul bilan chetlab o'tib bo'lmaydi).
# Bo'sh qoldirilsa: userbot yoki local server yoqilgan bo'lsa 1900MB, aks holda 45MB.
# CHUNK_SIZE_MB=

# Yuborilgan har bir faylning captionidagi "ORDERED MOVIES" havolasi.
ORDER_CHANNEL_URL=https://t.me/Cart_In_Eng
